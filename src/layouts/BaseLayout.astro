---
import '../styles/global.css';
import MarkdownAlternateLink from '../components/MarkdownAlternateLink.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	dateModified?: string;
}

const {
	title = 'Jasper Kooij',
	description = 'Director of Web Development',
	image = '/og-image.png',
	dateModified
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const currentYear = new Date().getFullYear();
// Chrome WebMCP origin trial — register https://jasperkooij.com at
// https://developer.chrome.com/origintrials then set PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN.
const originTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN;

const schemaGraph = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": "https://jasperkooij.com/#website",
		"url": "https://jasperkooij.com/",
		"name": "Jasper Kooij",
		"description": "Full-stack developer specialising in travel, hospitality, and tourism clients.",
		"publisher": { "@id": "https://jasperkooij.com/#person" }
	},
	{
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		"@id": `${canonicalURL}#webpage`,
		"url": canonicalURL,
		"name": title,
		"description": description,
		"isPartOf": { "@id": "https://jasperkooij.com/#website" },
		"about": { "@id": "https://jasperkooij.com/#person" },
		"mainEntity": { "@id": "https://jasperkooij.com/#person" },
		...(dateModified ? { "dateModified": dateModified } : {}),
		"copyrightHolder": { "@id": "https://jasperkooij.com/#person" },
		"copyrightYear": currentYear,
		"publishingPrinciples": "https://jasperkooij.com/#about"
	},
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"@id": "https://jasperkooij.com/#person",
		"name": "Jasper Kooij",
		"description": "Full-stack developer and technical team leader with over 25 years of experience, specialising in travel, hospitality, and tourism clients.",
		"jobTitle": "Director of Web Development",
		"image": "https://cdn.builder.io/api/v1/image/assets%2F06e23a278b8341c7a916ce880385fb89%2F7edac098d9ab4d7a916c474e8908cb21",
		"email": "jasperkooij@gmail.com",
		"telephone": "+1.608.469.7003",
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Madison",
			"addressRegion": "WI",
			"addressCountry": "US"
		},
		"worksFor": {
			"@type": "Organization",
			"name": "Blend Marketing",
			"url": "https://blend.travel"
		},
		"url": "https://jasperkooij.com/",
		"sameAs": [
			"https://www.linkedin.com/in/jasperkooij/",
			"https://bsky.app/profile/jasperkooij.com",
			"https://twitter.com/jasperkooij",
			"https://github.com/jasperkooij"
		],
		"knowsAbout": [
			"Full-Stack Web Development",
			"WordPress",
			"Svelte",
			"React",
			"Astro",
			"Booking Engine Integration",
			"Cloudflare Workers",
			"Performance Optimization",
			"Travel & Hospitality Websites",
			"Headless CMS"
		],
		"hasOfferCatalog": {
			"@type": "OfferCatalog",
			"name": "Services",
			"itemListElement": [
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "Full-Stack Web Development" }
				},
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "Technical Team Leadership" }
				},
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "Booking Engine Integration" }
				},
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "Performance & Core Web Vitals Optimization" }
				},
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "SEO & A/B Testing" }
				},
				{
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": "Cloud-Based Analytics Solutions" }
				}
			]
		}
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{originTrialToken && (
			<meta http-equiv="origin-trial" content={originTrialToken} />
		)}
		<link rel="preconnect" href="https://cdn.builder.io" />
		<title>{title}</title>
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme) document.documentElement.setAttribute('data-theme', theme);
			} catch {}
		</script>
		<meta name="description" content={description} />
		<meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		<MarkdownAlternateLink />
		<ClientRouter />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jasper Kooij" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Jasper Kooij - Full Stack Developer" />

		<!-- Twitter / X Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@jasperkooij" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
	</head>
	<body>
		<slot />
		<script src="../scripts/webmcp.ts"></script>
	</body>
</html>
