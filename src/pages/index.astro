---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import BuilderContentHybrid from '../components/BuilderContentHybrid.svelte';
import FAQSchema from '../components/FAQSchema.astro';
import { env } from 'cloudflare:workers';
import { fetchBuilderContent } from '../utils/builderContent';

const apiKey = import.meta.env.PUBLIC_BUILDER_API_KEY;
const title = 'Jasper Kooij - Full Stack Developer';
const description = 'Full-stack developer and technical team leader with over 25 years at the forefront of web innovation.';

const kv = (env as any).BUILDER_CACHE;
const builderContent = await fetchBuilderContent(apiKey, '/', kv);
const dateModified = builderContent?.lastUpdated
	? new Date(builderContent.lastUpdated).toISOString()
	: undefined;
---

<BaseLayout title={title} description={description} dateModified={dateModified}>
	<Navbar />
	<div class="flex min-h-screen items-center justify-center px-4 py-10">
		<div class="bg-base-100 text-base-content w-full max-w-6xl rounded-xl shadow-lg sm:p-10 md:p-6">
			<main>
				<div id="about">
					<BuilderContentHybrid client:load apiKey={apiKey} model="page" urlPath="/" initialContent={builderContent} />
				</div>

				<FAQSchema />

				<!-- Contact Form Section -->
				<section class="py-12">
					<div class="container mx-auto px-4" id="contact">
						<ContactForm />
					</div>
				</section>
			</main>
		</div>
	</div>
	<Footer />
</BaseLayout>
